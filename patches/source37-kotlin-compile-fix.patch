+    /** Classifies the final native generation outcome using explicit evidence only. */
+    fun finalTerminationReason(
+        output: String,
+        metrics: String,
+        requestedTokens: Int,
+        continuationStillCapped: Boolean,
+        nativeLogTail: String,
+        timedOut: Boolean = false
+    ): String {
+        if (timedOut) return "timeout"
+        if (Regex("(?:^|[;\\s])cancelled=true(?:[;\\s]|$)").containsMatchIn(metrics)) return "user_stop"
+        val native = nativeLogTail.lowercase()
+        val contextLimitEvidence = listOf(
+            "n_past + n_tokens > n_ctx",
+            "context limit reached",
+            "context is full",
+            "context overflow",
+            "input exceeds context",
+            "prompt exceeds context"
+        ).any { it in native }
+        if (contextLimitEvidence) return "context_limit"
+        val engineError = output.isBlank() ||
+            output.startsWith("无法创建本地推理上下文") ||
+            output.startsWith("无法初始化 Token 采样器") ||
+            output.startsWith("模型预填充失败") ||
+            output.startsWith("无法分配 Token 采样器") ||
+            native.contains("native inference exception") ||
+            native.contains("prompt_prefill_batch_failed") ||
+            Regex("decode stopped with result=-?\\d+").containsMatchIn(native)
+        if (engineError) return "engine_error"
+        if (continuationStillCapped || reachedTokenLimit(metrics, requestedTokens)) return "hard_limit"
+        return "natural_stop"
+    }
 
